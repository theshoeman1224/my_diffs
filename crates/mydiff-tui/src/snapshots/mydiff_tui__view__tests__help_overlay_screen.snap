" left.txt                                 right.txt                             "
"   1 alpha                                  1 alpha                             "
"┌ keys ───────────────────────────────────────────────────────────────────────┐ "
"│j k / ↓ ↑ / wheel                down / up                                   │ "
"│PgDn Space Ctrl-d / PgUp Ctrl-u  page down / up                              │ "
"│g Home / G End                   top / bottom                                │ "
"│n / p N                          next / prev change                          │ "
"│h ← / l →                        scroll left / right                         │ "
"│w                                whitespace (exact → trailing → change → all)│ "
"│i                                ignore case                                 │ "
"│b                                ignore blank lines                          │ "
"│e                                ignore line endings (CRLF vs LF)            │ "
"│u                                layout                                      │ "
"│Tab                              toggle this sidebar                         │ "
"│Tab then ← / →                   dock left / right                           │ "
"│?                                toggle help                                 │ "
"│q / Esc                          quit or go back (Esc closes help first)     │ "
"│Ctrl-c                           quit from anywhere                          │ "
"│                                                                             │ "
"│ removed  added  modified changed text ignored                               │ "
"└─────────────────────────────────────────────────────────────────────────────┘ "
