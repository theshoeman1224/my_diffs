---
source: crates/mydiff/tests/git.rs
expression: stdout(&out)
---
diff --git a/conf.yaml b/conf.yaml
--- a/conf.yaml
+++ b/conf.yaml
~ $.port: 80 → 8080
diff --git a/data.json b/data.json
--- a/data.json
+++ b/data.json
@@ -1,1 +1,1 @@
-{"ok": 1}
+{"ok": 
diff --git a/f.txt b/f.txt
--- a/f.txt
+++ b/f.txt
@@ -1,3 +1,3 @@
 alpha
-beta
+beta changed
 gamma
diff --git a/my notes.txt b/my notes.txt
--- a/my notes.txt
+++ b/my notes.txt
@@ -1,1 +1,1 @@
-draft
+final
diff --git a/n.txt b/n.txt
--- /dev/null
+++ b/n.txt
@@ -0,0 +1,1 @@
+new file
diff --git a/old.json b/old.json
--- a/old.json
+++ /dev/null
@@ -1,1 +0,0 @@
-{"gone": true}
diff --git a/sub/s.txt b/sub/u.txt
similarity index 79%
rename from sub/s.txt
rename to sub/u.txt
index f384549..b2f931a 100644
--- a/sub/s.txt
+++ b/sub/u.txt
@@ -2,3 +2,4 @@
 two
 three
 four
+five
